# Solana RPC endpoint (use your own for production)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Your wallet private key (base58 encoded) - KEEP SECRET
WALLET_PRIVATE_KEY=your_private_key_here

# Trading mode: 'simulation' or 'live'
TRADING_MODE=simulation

# Minimum profit threshold in USD to execute a trade
MIN_PROFIT_USD=0.10

# Maximum trade size in SOL
MAX_TRADE_SIZE_SOL=1.0

# Slippage tolerance in basis points (50 = 0.5%)
SLIPPAGE_BPS=50

# WebSocket server port for dashboard
WS_PORT=8080

# Scan interval in milliseconds
SCAN_INTERVAL_MS=2000

# Enable/disable specific DEX pairs
ENABLE_RAYDIUM=true
ENABLE_ORCA=true
ENABLE_METEORA=true
ENABLE_LIFINITY=true
